{
  "name": "vite-plugin-tailscale-funnel",
  "version": "0.0.1",
  "description": "A Vite plugin that exposes local development servers through Tailscale Funnel",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./virtual": {
      "types": "./dist-types/virtual.d.ts"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist",
    "dist-types"
  ],
  "scripts": {
    "build": "npm run dist-types && tsup",
    "dev": "npm run dist-types && tsup --watch",
    "dist-types": "mkdir -p dist-types && cp src/virtual.d.ts dist-types/virtual.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "tailscale",
    "funnel",
    "tunnel",
    "development",
    "local-development",
    "tailscale"
  ],
  "author": "https://github.com/eastlondoner",
  "license": "MIT",
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
